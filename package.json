{
  "name": "tethera-ecommerce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:check": "node scripts/test-supabase.mjs",
    "db:seed": "npx tsx scripts/seed-supabase.ts",
    "test": "vitest run",
    "test:auth": "vitest run tests/auth-boundaries.test.ts",
    "dev:demo": "node scripts/dev-demo.mjs",
    "preview:builder": "node scripts/preview-builder.mjs",
    "test:db": "vitest run tests/database-failures.test.ts tests/database-migrations.test.ts tests/checkout-transactions.test.ts tests/database-permissions.test.ts",
    "test:checkout": "vitest run tests/trusted-checkout.test.ts tests/checkout-transactions.test.ts",
    "test:payments": "vitest run tests/midtrans-gateway.test.ts tests/checkout-transactions.test.ts tests/inventory-lifecycle.test.ts",
    "test:refunds": "vitest run tests/refund-recovery.test.ts tests/checkout-transactions.test.ts tests/phase3-inventory-ledger.test.ts",
    "test:shipping": "vitest run tests/shipping-dispatch.test.ts tests/packaged-fulfillment.test.ts tests/checkout-transactions.test.ts",
    "test:security": "vitest run tests/database-permissions.test.ts tests/public-catalog-privacy.test.ts tests/auth-boundaries.test.ts",
    "test:financials": "vitest run tests/financial-reconciliation.test.tsx tests/checkout-transactions.test.ts tests/phase3-cust04-tax-itemization.test.ts tests/phase3-admin05-promotions-engine.test.ts",
    "test:jobs": "vitest run tests/durable-jobs.test.ts tests/database-permissions.test.ts tests/checkout-transactions.test.ts",
    "jobs:run": "node scripts/run-background-jobs.mjs",
    "validate": "node scripts/validate.mjs",
    "test:e2e": "node scripts/validate.mjs --stage browser",
    "typecheck": "tsc --noEmit --incremental false --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/open-sauce-one": "^5.3.0",
    "@supabase/supabase-js": "^2.45.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.453.0",
    "next": "15.5.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "packageManager": "npm@11.19.0"
}
