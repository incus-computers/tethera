# ==============================================================================
# TETHERA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Server-Side Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Marketplace Integration Webhook Secrets
MARKETPLACE_DEFAULT_PROVIDER=ginee
MARKETPLACE_WEBHOOK_SECRET=your-secret-token-for-webhooks

# Biteship Multi-Courier Logistics API (JNE, J&T, SiCepat, AnterAja, Gojek, Grab)
BITESHIP_API_KEY=biteship_test.your_biteship_api_token_here
BITESHIP_BASE_URL=https://api.biteship.com/v1
BITESHIP_WEBHOOK_SECRET=your_biteship_webhook_signature_secret

# Google Maps Platform API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional Notifications
SENDGRID_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Verified authentication (see docs/authentication-and-demo.md)
# Use npm run dev:demo for isolated local dummy accounts/integrations.
APP_ENV=staging
APP_URL=http://localhost:3000
TRACKING_TOKEN_SECRET=replace_with_at_least_32_random_characters
MIDTRANS_SERVER_KEY=
# Configure this header on Biteship: x-biteship-token

# Hosted Midtrans: configure sandbox first; production activation remains deferred.
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=
MIDTRANS_PRODUCTION_ENABLED=false
APP_ORIGIN=https://your-staging-store.example
# Independent random secret (32+ characters) for the reconciliation scheduler.
PAYMENT_JOB_SECRET=

# Biteship: test first; see docs/biteship-shipping.md. Never enable production in demo.
BITESHIP_ENV=test
BITESHIP_PRODUCTION_ENABLED=false
# Confirm the actual warehouse origin before any provider booking.
BITESHIP_ORIGIN_CONFIRMED=false
# Independent random secret (32+ characters) for POST /api/internal/shipping/reconcile.
SHIPPING_JOB_SECRET=

# Midtrans refunds: enable only after isolated sandbox setup (docs/refunds-and-returns.md).
MIDTRANS_REFUNDS_ENABLED=false
# Independent random secret (32+ characters) for POST /api/internal/refunds/reconcile.
REFUND_JOB_SECRET=

# Step 11: confirm merchant/product/service tax treatment before connected checkout.
# Do not choose a rate until reviewed. See docs/financial-reconciliation.md.
TAX_POLICY_CONFIRMED=false
TAX_POLICY_ID=
TAX_COLLECTION_MODE=
TAX_EFFECTIVE_RATE_BPS=
# Optional dummy-only effective rate: 1100=11%, 1200=12%, 0=no tax collected.
DEMO_TAX_EFFECTIVE_RATE_BPS=1100

# Step 12: durable queue. Schedule npm run jobs:run every minute on the deployment.
BACKGROUND_JOB_SECRET=
BACKGROUND_WORKER_URL=https://your-staging-store.example
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# Approved WhatsApp utility template: body parameters [order number, event status].
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=id
# Marketplace provider/stock authority remains undecided; real sync is disabled.

# Step 17: independent random secrets (32+ characters), staging/production only.
ABUSE_HMAC_SECRET=
# Only a verified, overwritten single-IP ingress header; blank uses a shared bucket.
ABUSE_TRUSTED_IP_HEADER=
OPERATIONS_MONITOR_SECRET=
