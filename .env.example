# Supabase Server-Side Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Marketplace Integration Webhook Secrets
MARKETPLACE_DEFAULT_PROVIDER=ginee
MARKETPLACE_WEBHOOK_SECRET=your-secret-token-for-webhooks

# Optional Notifications (SendGrid / WhatsApp Business API)
