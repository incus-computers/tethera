# ==============================================================================
# TETHERA ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Server-Side Database Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Marketplace Integration Webhook Secrets
MARKETPLACE_DEFAULT_PROVIDER=ginee
MARKETPLACE_WEBHOOK_SECRET=your-secret-token-for-webhooks

# Biteship Multi-Courier Logistics API (JNE, J&T, SiCepat, AnterAja, Gojek, Grab)
# Get your API key from https://biteship.com/dashboard/settings/api
BITESHIP_API_KEY=biteship_test.your_biteship_api_token_here
BITESHIP_BASE_URL=https://api.biteship.com/v1
BITESHIP_WEBHOOK_SECRET=your_biteship_webhook_signature_secret

# Google Maps Platform API Key (Places Autocomplete, Geocoding, Maps JavaScript API)
# Enable: Maps JavaScript API, Places API, Geocoding API at https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional Notifications (SendGrid / WhatsApp Business API)
SENDGRID_API_KEY=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
